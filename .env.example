# Copy to .env.local and fill in real values.
# Never commit .env.local or real API keys.

# Resend API key for sending contact form emails
RESEND_API_KEY=re_your_api_key_here

# Destination address where portfolio contact submissions are delivered
CONTACT_TARGET_EMAIL=your-real-email@example.com

# Sender address.
# MUST use a domain verified in your Resend account.
CONTACT_FROM_EMAIL="Portfolio Contact <contact@your-verified-domain.com>"
